				}
				title: "Any #tfc:stone_tools"
				type: "item"
			}]
			title: "Stone Tool Heads"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["270DA708118B3F22"]
			description: ["Axes can be used to cut down entire trees, logs and leaves included. However, saplings and sticks will only be obtained if leaves were broken individually."]
