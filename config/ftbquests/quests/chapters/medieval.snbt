			title: "Early Ores"
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["51954140375A78E0"]
			description: ["With a tool head in hand, you are now able to craft your first pickaxe! Find enough copper to make a pickaxe head, fire a pickaxe mold and melt the ore using a pit kiln, then cast a head. Slap it on a stick, and voila!"]
			id: "2FA4F33E8A962A30"
