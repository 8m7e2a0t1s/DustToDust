		{
			dependencies: ["412CC0246CBD6C35"]
			description: ["Salting is a way to make meat last longer. To salt meat, it must be crafted with Salt in a crafting grid. Only raw meat can be salted. Afterwards, cooking or otherwise preserving the meat does not take away the salted property."]
			id: "2CCABD1D759EB7D6"
			subtitle: "Someone's salty..."
			tasks: [{
