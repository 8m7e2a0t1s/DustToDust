	quests: [
		{
			dependencies: ["2455034B13B918D8"]
			description: ["In TerraFirmaCraft, the first things you can obtain are sticks, twigs, and loose rocks. They can be found in almost every climate, lying scattered on the ground. Right Click or break these to pick them up. In addition to gathering sticks and twigs on the ground, sticks can also be obtained by breaking leaves with your fist."]
			id: "3FD56221E3C69A6A"
			subtitle: "@grok how do I play the game?"
			tasks: [
				{
					id: "611B83E7942FAD4F"
					item: {
						Count: 1
						id: "itemfilters:tag"
						tag: {
							value: "rnr:loose_rock_items"
