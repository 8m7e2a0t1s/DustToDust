		{
			dependencies: [
				"4D45D23469BC4311"
				"054A8C005F62DECE"
			]
			description: [
				"In TerraFirmaCraft, no food will last forever! Food will expire over time, turning rotten. Rotten food will not restore any hunger, and has the potential to give you unhelpful effects such as Hunger or Poison."
				""
				"One of the easiest ways to preserve food is to use a Large Vessel. Large Vessels are a block which can store up to nine items, and when sealed the items inside will gain the Preserved status, which extends their remaining lifetime by 2x."
			]
			id: "29A403FD9F5D5D09"
			subtitle: "Preserve your food!"
			tasks: [{
				id: "7BFFB5EB9AC4D464"
				item: "tfc:ceramic/large_vessel"
				type: "item"
			}]
			title: "Preservation"
